Windows Registry Editor Version 5.00

; ========================================================
; Bersihkan registry lama jika ada
; ========================================================
[-HKEY_CURRENT_USER\Software\Classes\*\shell\TakeOwnership]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\TakeOwnership]
[-HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\TakeOwnership]

; ========================================================
; Take Ownership Context Menu (PowerShell Berbasis Runas)
; ========================================================

; --- Untuk Semua File (*) ---
[HKEY_CURRENT_USER\Software\Classes\*\shell\runas]
@="Take Ownership"
"Icon"="imageres.dll,-78"
"HasLUAShield"=""
"NoWorkingDirectory"=""

[HKEY_CURRENT_USER\Software\Classes\*\shell\runas\command]
@="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Normal -File \"C:\\tools\\take_ownership\\TakeOwnership.ps1\" \"%1\""
"IsolatedCommand"="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Normal -File \"C:\\tools\\take_ownership\\TakeOwnership.ps1\" \"%1\""

; --- Untuk Semua Folder (Directory) ---
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\runas]
@="Take Ownership"
"Icon"="imageres.dll,-78"
"HasLUAShield"=""
"NoWorkingDirectory"=""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\runas\command]
@="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Normal -File \"C:\\tools\\take_ownership\\TakeOwnership.ps1\" \"%1\""
"IsolatedCommand"="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Normal -File \"C:\\tools\\take_ownership\\TakeOwnership.ps1\" \"%1\""

; --- Untuk Background Folder (Klik kanan di dalam folder) ---
[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\runas]
@="Take Ownership Folder Ini"
"Icon"="imageres.dll,-78"
"HasLUAShield"=""
"NoWorkingDirectory"=""

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\runas\command]
@="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Normal -File \"C:\\tools\\take_ownership\\TakeOwnership.ps1\" \"%V\""
"IsolatedCommand"="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Normal -File \"C:\\tools\\take_ownership\\TakeOwnership.ps1\" \"%V\""
